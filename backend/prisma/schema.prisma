generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  fullName     String        @db.VarChar(150)
  email        String        @unique @db.VarChar(255)
  passwordHash String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime?     @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?     @db.Timestamptz(6)
  accounts     Account[]
  bills        Bill[]
  categories   Category[]
  trackerItems TrackerItem[]
  trackerLogs  TrackerLog[]
  transactions Transaction[]

  @@index([email])
  @@map("users")
}

model Account {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @db.Uuid
  name           String        @db.VarChar(100)
  kind           AccountKind
  openingBalance Decimal       @default(0) @db.Decimal(14, 2)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime?     @updatedAt @db.Timestamptz(6)
  deletedAt      DateTime?     @db.Timestamptz(6)
  isActive       Boolean       @default(true)
  user           User          @relation(fields: [userId], references: [id])
  billPayments   Bill[]
  transactions   Transaction[]

  @@index([userId])
  @@map("accounts")
}

model Category {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  name         String        @db.VarChar(100)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime?     @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime?     @db.Timestamptz(6)
  isSystem     Boolean       @default(false)
  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]

  @@unique([userId, name])
  @@unique([id, userId])
  @@index([userId])
  @@map("categories")
}

model Transaction {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  accountId   String    @db.Uuid
  categoryId  String?   @db.Uuid
  type        TxnType
  amount      Decimal   @db.Decimal(14, 2)
  description String?
  occurredOn  DateTime  @db.Date
  billId      String?   @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime? @updatedAt @db.Timestamptz(6)
  account     Account   @relation(fields: [accountId], references: [id])
  bill        Bill?     @relation(fields: [billId], references: [id])
  category    Category? @relation(fields: [categoryId, userId], references: [id, userId])
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@index([billId])
  @@index([occurredOn])
  @@map("transactions")
}

model TrackerItem {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  name      String       @db.VarChar(150)
  unit      String       @db.VarChar(30)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt DateTime?    @updatedAt @db.Timestamptz(6)
  deletedAt DateTime?    @db.Timestamptz(6)
  price     Decimal      @db.Decimal(14, 2)
  bills     Bill[]
  user      User         @relation(fields: [userId], references: [id])
  logs      TrackerLog[]

  @@index([userId])
  @@map("tracker_items")
}

model TrackerLog {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  itemId    String      @db.Uuid
  logDate   DateTime    @db.Date
  quantity  Decimal     @db.Decimal(14, 3)
  amount    Decimal     @db.Decimal(14, 2)
  note      String?
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt DateTime?   @updatedAt @db.Timestamptz(6)
  billId    String?     @db.Uuid
  isBilled  Boolean     @default(false)
  bill      Bill?       @relation(fields: [billId], references: [id])
  item      TrackerItem @relation(fields: [itemId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@unique([itemId, logDate])
  @@index([userId])
  @@index([itemId])
  @@index([billId])
  @@map("tracker_logs")
}

model Bill {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  itemId        String        @db.Uuid
  periodStart   DateTime      @db.Date
  periodEnd     DateTime      @db.Date
  totalQuantity Decimal       @db.Decimal(14, 3)
  totalAmount   Decimal       @db.Decimal(14, 2)
  status        BillStatus    @default(pending)
  paidAccountId String?       @db.Uuid
  paidOn        DateTime?     @db.Date
  createdAt     DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime?     @updatedAt @db.Timestamptz(6)
  item          TrackerItem   @relation(fields: [itemId], references: [id])
  paidAccount   Account?      @relation(fields: [paidAccountId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  trackerLogs   TrackerLog[]
  transactions  Transaction[]

  @@index([userId])
  @@index([itemId])
  @@index([paidAccountId])
  @@map("bills")
}

enum AccountKind {
  bank
  cash
}

enum TxnType {
  credit
  debit
}

enum BillStatus {
  pending
  paid
}
